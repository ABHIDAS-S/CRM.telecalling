# SMTP account used only for password-reset OTP email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="CRM Support <no-reply@example.com>"

# Tally integration: hash of the original sender API key, not the key itself.
TALLY_API_KEY_SHA256=
